{
  "language": "japanese",
  "permissions": {
    "deny": [
      "Read(./api/gen/**/*)",
      "Read(./web/src/gen/**/*)",
      "Read(./web/dist/**/*)"
    ]
  },
  "enabledMcpjsonServers": [
    "heroui-react"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/web/scripts/heroui-docs.sh"
          }
        ]
      }
    ]
  }
}
